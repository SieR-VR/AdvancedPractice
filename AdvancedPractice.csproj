<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LegatoSourceVersion>1.40.8</LegatoSourceVersion>
    <LegatoTargetVersion Condition="'$(LegatoTargetVersion)' == ''">1.44.1</LegatoTargetVersion>
    <!-- Use only our scoped NJS patch; Legato's unrelated XR hooks need publicized APIs. -->
    <LegatoEnableHarmonyEvents>false</LegatoEnableHarmonyEvents>
    <ModReferencesDir Condition="'$(ModReferencesDir)' == ''">$(BeatSaberDir)\Plugins</ModReferencesDir>
  </PropertyGroup>
  <Import Project="Build\Versions.props" />
  <ItemGroup>
    <Compile Include="Plugin.cs;AdvancedPracticeController.cs;Configuration\PluginConfig.cs;Compatibility\*.cs;Models\*.cs;Views\*.cs;Properties\AssemblyInfo.cs" />
    <Reference Include="$(BeatSaberDir)\Beat Saber_Data\Managed\*.dll" Private="false" />
    <Reference Include="$(BeatSaberDir)\Libs\0Harmony.dll" Private="false" />
    <Reference Include="$(ModReferencesDir)\BSML.dll" Private="false" />
    <EmbeddedResource Include="Views\*.bsml" />
    <EmbeddedResource Include="$(IntermediateOutputPath)manifest.json" LogicalName="AdvancedPractice.manifest.json" />
    <PackageReference Include="LegatoBS" Version="0.1.1" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="Build\VersionedBuild.targets" />
</Project>
